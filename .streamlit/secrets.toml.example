# Copy this file to .streamlit/secrets.toml and fill in your own values.
# secrets.toml is listed in .gitignore and must never be committed.

# The shared password people type to open the app.
APP_PASSWORD = ""

# Set to true only when the app runs on a hosting service.
# This hides Save and Delete so nothing personal is written to the server's disk.
HOSTED = false

# Your Groq API key from https://console.groq.com/keys. Paste it between the quotes.
# Without it, the AI assistant tab shows setup instructions and the other tabs still work.
GROQ_API_KEY = ""

# Optional: which Groq model the AI assistant uses.
GROQ_MODEL = "openai/gpt-oss-120b"
